<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

    <application
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_descriptor"
        android:icon="@mipmap/logo_v2"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/logo_v2_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".game.activity.SelectPlayersActivity" android:exported="false" />
        <activity android:name=".game.activity.SelectObjectivesActivity" android:exported="false" />
        <activity android:name=".game.activity.ScoresResultActivity" android:exported="false" />
        <activity android:name=".game.turn.activity.SelectStoryTellerActivity" android:exported="false" />
        <activity android:name=".game.turn.activity.EveryoneFoundActivity" android:exported="false" />
        <activity android:name=".game.turn.activity.EndTurnActivity" android:exported="false" />
        <activity android:name=".game.turn.activity.WhoDidFindActivity" android:exported="false" />
        <activity android:name=".game.turn.activity.SelectVotesActivity" android:exported="false" />
        <activity android:name=".stats.activity.StatsActivity" android:exported="false" />
        <activity android:name=".rules.activity.RulesActivity" android:exported="false" />
    </application>

</manifest>
